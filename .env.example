ANTHROPIC_API_KEY=your-anthropic-api-key-here
TWELVE_DATA_API_KEY=your-twelve-data-api-key-here
MARKETAUX_API_KEY=your-marketaux-api-key-here
PORT=3000

# Optional: BUY/SELL email alerts (XAU/1h, checked every 15 min).
# EMAIL_APP_PASSWORD is a Gmail App Password (not your normal password) -
# create one at https://myaccount.google.com/apppasswords. Leave both unset
# to disable alerts entirely.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
# Optional recipient override - defaults to EMAIL_USER (send to yourself)
EMAIL_TO=recipient@example.com
