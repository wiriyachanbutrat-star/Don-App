# Required — market data (https://twelvedata.com, free tier works)
TWELVE_DATA_API_KEY=your-twelve-data-api-key-here

# Optional — HTTP port (default 3000)
PORT=3000

# Optional — AI commentary. When set, the dashboard shows a button that asks
# Claude to explain the current signal in Thai (context, risks, invalidation).
# It never changes the BUY/SELL/WAIT verdict or the price levels — explanation
# only. Each click costs a Claude API call. Leave unset to hide the button.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# CLAUDE_MODEL=claude-opus-5

# Optional — email BUY/SELL alerts. Polls one asset/timeframe every 15 min and
# mails only when the tradable signal first appears or flips direction (never
# repeats, never mails on WAIT). Leave EMAIL_USER / EMAIL_APP_PASSWORD unset to
# disable entirely. EMAIL_APP_PASSWORD is a Gmail App Password, not your normal
# password: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_TO=recipient@example.com
EMAIL_ASSET=XAU
EMAIL_INTERVAL=4h
